[Unit]
Description=NetBird mesh network client
ConditionFileIsExecutable=/usr/bin/netbird
After=network.target syslog.target 

[Service]
EnvironmentFile=-/etc/sysconfig/netbird
ExecStartPre=/usr/bin/rm -f /run/netbird.sock
ExecStart=/usr/bin/netbird service run --log-level warn --daemon-addr unix:///run/netbird.sock --log-file /var/log/netbird/client.log

Restart=always
RestartSec=120
StartLimitInterval=5
StartLimitBurst=10

# Sandboxing
# ProtectHome= and ProtectKernelTunables= are intentionally omitted:
# - ProtectHome would break the debug bundle (needs home dir access)
# - ProtectKernelTunables would break sysctl writes (ip_forward, rp_filter)
PrivateDevices=true
BindPaths=/dev/net/tun
DeviceAllow=/dev/net/tun rw
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
